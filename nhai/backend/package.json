{
  "name": "datalake-backend",
  "version": "1.0.0",
  "description": "Offline-first sync backend for NHAI Datalake 3.0 facial-recognition attendance system",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite ts-node src/server.ts",
    "seed": "cross-env NODE_OPTIONS=--experimental-sqlite ts-node src/scripts/seed.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite jest --runInBand"
  },
  "keywords": [
    "nhai",
    "offline",
    "attendance",
    "facial-recognition",
    "sync"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "cross-env": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
