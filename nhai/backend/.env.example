# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Database (use ':memory:' for ephemeral, or a file path)
DB_PATH=./data/datalake.db

# Demo data
# Set to 'true' on ephemeral hosting (e.g. Render free tier) to recreate demo
# employees and attendance history on every boot. Leave unset/false when the
# database is backed by a persistent disk.
SEED_DEMO_DATA=false
