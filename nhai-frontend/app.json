{
  "expo": {
    "name": "Aegis",
    "slug": "aegis-nhai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1428",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1428"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nhai.aegis",
      "deploymentTarget": "15.1",
      "newArchEnabled": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aegis requires camera access for facial recognition and liveness detection.",
        "NSFaceIDUsageDescription": "Aegis uses biometric data for secure authentication.",
        "NSLocationWhenInUseUsageDescription": "Optional: Location is logged for verification audit trails.",
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1428"
      },
      "package": "com.nhai.aegis",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "newArchEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aegis logs GPS coordinates to verification audit records for NHAI compliance."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.21",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1",
            "newArchEnabled": true
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Aegis requires camera access for facial recognition and liveness detection."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ffd3c941-cb95-4d2d-973f-ef3904845ab9"
      }
    },
    "owner": "muthuraj14"
  }
}
